---
import Base from "./Base.astro";

interface Props {
  title: string;
  subtitle?: string;
  summary: string;
  date: Date;
  version?: string;
  previousVersion?: string;
  lang: "zh" | "en";
}

const { title, subtitle, summary, date, version, previousVersion, lang } = Astro.props;
const locale = lang === "zh" ? "zh-Hans" : "en-US";
const formattedDate = date.toLocaleDateString(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const previousLabel = lang === "zh" ? "上一个稳定版" : "previously";
const subtitleLine =
  subtitle ??
  [version && `save_it ${version}`, previousVersion && `${previousLabel} ${previousVersion}`]
    .filter(Boolean)
    .join(" · ");
---

<Base title={`${title} · save_it`} description={summary} lang={lang}>
  <article class="page">
    <div class="meta">
      <span>{formattedDate}</span>
    </div>
    <h1>{title}</h1>
    {subtitleLine && <p class="subtitle">{subtitleLine}</p>}
    <p class="lede">{summary}</p>
    <slot />
  </article>
</Base>
