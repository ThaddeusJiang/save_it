---
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/inter-tight/index.css";
import "@fontsource-variable/fraunces/index.css";
import "@fontsource/instrument-serif/index.css";
import "@fontsource-variable/instrument-sans/index.css";
import "@fontsource-variable/noto-sans-sc/index.css";
import "@fontsource-variable/noto-serif-sc/index.css";

const cjkSans = '"Noto Sans SC Variable", "PingFang SC", "Microsoft YaHei", sans-serif';
const cjkSerif = '"Noto Serif SC Variable", "Songti SC", serif';

const schemes = [
  {
    id: "A",
    name: "Geist + Noto Sans SC",
    note: "全无衬线，现代产品站风格（Vercel 同款 Geist），中英字形最统一",
    display: `"Geist Variable", ${cjkSans}`,
    body: `"Geist Variable", ${cjkSans}`,
    displayWeight: 600,
    displayTracking: "-0.03em",
  },
  {
    id: "B",
    name: "Inter Tight + Inter + Noto Sans SC",
    note: "标题用紧排 Inter Tight，正文 Inter，克制、可读性最好",
    display: `"Inter Tight Variable", ${cjkSans}`,
    body: `"Inter Variable", ${cjkSans}`,
    displayWeight: 650,
    displayTracking: "-0.025em",
  },
  {
    id: "C",
    name: "Fraunces + Inter + Noto Serif/Sans SC",
    note: "标题软衬线（杂志感，最接近 Dia 的气质），正文无衬线",
    display: `Fraunces Variable, ${cjkSerif}`,
    body: `"Inter Variable", ${cjkSans}`,
    displayWeight: 600,
    displayTracking: "-0.015em",
  },
  {
    id: "D",
    name: "Instrument Serif + Instrument Sans（当前）",
    note: "高对比衬线标题，中文标题压不住，字号小时容易发虚",
    display: `"Instrument Serif", ${cjkSerif}`,
    body: `"Instrument Sans Variable", ${cjkSans}`,
    displayWeight: 400,
    displayTracking: "-0.015em",
  },
];
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>字体方案对比</title>
    <style>
      body {
        background: #f6f4ef;
        color: #1b1a18;
        margin: 0 auto;
        max-width: 46rem;
        padding: 3rem 1.25rem 6rem;
      }
      .scheme {
        border-top: 1px solid #d8d4c8;
        padding: 2rem 0;
      }
      .tag {
        color: #6d6a63;
        font-family: "Geist Mono Variable", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      h2 {
        line-height: 1.14;
        margin: 0.6rem 0;
        font-size: clamp(2rem, 5.5vw, 2.8rem);
      }
      h3 {
        font-size: 1.5rem;
        margin: 1.6rem 0 0.4rem;
      }
      p {
        font-size: 1.0625rem;
        line-height: 1.75;
        margin: 0 0 0.9rem;
      }
      code {
        background: rgba(0, 0, 0, 0.05);
        border-radius: 3px;
        font-family: "Geist Mono Variable", monospace;
        font-size: 0.85em;
        padding: 0.1em 0.35em;
      }
    </style>
  </head>
  <body>
    <p class="tag">字体方案对比 · 选一个告诉我</p>
    {
      schemes.map((s) => (
        <section
          class="scheme"
          style={`font-family:${s.body}`}
        >
          <p class="tag">
            方案 {s.id} — {s.name}
          </p>
          <h2 style={`font-family:${s.display};font-weight:${s.displayWeight};letter-spacing:${s.displayTracking}`}>
            save_it 2026.9.3：GIF 能播了，链接不再丢
          </h2>
          <p style="color:#6d6a63">{s.note}</p>
          <h3 style={`font-family:${s.display};font-weight:${s.displayWeight};letter-spacing:${s.displayTracking}`}>
            保存的 GIF 变成能播的动图 / Saved GIFs now play inline
          </h3>
          <p>
            现在 save_it 会在上传前把 GIF 本地转成 Telegram 友好的 mp4（libx264 / yuv420p /
            faststart），再作为 animation 发送。ffmpeg 不可用或转码失败时，会退回发送原始 GIF。
          </p>
          <p>
            save_it now transcodes GIFs to Telegram-friendly mp4 before upload and sends them as
            animations, so they loop inline instead of arriving as a file attachment. Reply{" "}
            <code>/info</code> to any saved media to see where it came from.
          </p>
        </section>
      ))
    }
  </body>
</html>
